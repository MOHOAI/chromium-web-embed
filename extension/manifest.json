{
  "manifest_version": 3,
  "name": "Moho Browser Workspace",
  "version": "4.2.0",
  "description": "Isolated Chromium workspace bridge for web apps, full local browser automation, MCP tools, and multi-provider AI Computer Use agents (Gemini, Claude, OpenAI, and custom VLMs).",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://*/*",
      "https://*/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moho Browser Workspace"
  }
}
