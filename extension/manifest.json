{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Moho Browser Workspace",
  "version": "7.0.0",
  "description": "Isolated Chromium workspace bridge, Chrome Side Panel, WebMCP, Set-of-Mark & ARIA snapshots, Windows 10/11 Virtual Desktop Computer-Use broker with live preview, Local Folder Brain, and multi-provider AI agents (Gemini, Claude, OpenAI/ChatGPT, MOHO AI).",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://*/*",
      "https://*/*"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moho Browser Workspace v7.0"
  }
}
