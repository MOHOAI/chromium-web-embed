<Configuration>
  <VGpu>Enable</VGpu>
  <Networking>Enable</Networking>
  <ClipboardRedirection>Enable</ClipboardRedirection>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Python314</HostFolder>
      <SandboxFolder>C:\MohoPython</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\mohoa\Downloads\chromium-web-embed-repo\desktop-agent</HostFolder>
      <SandboxFolder>C:\MohoAgent</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd /c C:\MohoAgent\sandbox_bootstrap.bat</Command>
  </LogonCommand>
</Configuration>
