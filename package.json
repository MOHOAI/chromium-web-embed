{
  "name": "chromium-web-embed",
  "version": "2.1.2",
  "description": "Create and control isolated Chrome tab groups for approved web apps.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "extension",
    "extension-download",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js",
      "require": "./dist/extension.cjs"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/prepare-extension.mjs && node scripts/package-extension.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "archiver": "^8.0.0",
    "jsdom": "^26.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
