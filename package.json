{
  "name": "chromium-web-embed",
  "version": "7.0.0",
  "description": "Real Chromium browser workspace embedding, Windows 10/11 Virtual Desktop Computer-Use agent with live screen preview, Local Folder Brain (File System Access API), MCP tools, and multi-provider AI runtime (Gemini, Claude, OpenAI/ChatGPT, MOHO AI) powered by a Chrome MV3 extension.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js",
      "require": "./dist/extension.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./safety": {
      "types": "./dist/safety-policy.d.ts",
      "import": "./dist/safety-policy.js",
      "require": "./dist/safety-policy.cjs"
    },
    "./runner": {
      "types": "./dist/agent-runner.d.ts",
      "import": "./dist/agent-runner.js",
      "require": "./dist/agent-runner.cjs"
    },
    "./desktop": {
      "types": "./dist/desktop-agent.d.ts",
      "import": "./dist/desktop-agent.js",
      "require": "./dist/desktop-agent.cjs"
    },
    "./local-folder": {
      "types": "./dist/local-folder-brain.d.ts",
      "import": "./dist/local-folder-brain.js",
      "require": "./dist/local-folder-brain.cjs"
    },
    "./webmcp": {
      "types": "./dist/webmcp.d.ts",
      "import": "./dist/webmcp.js",
      "require": "./dist/webmcp.cjs"
    },
    "./terminal": {
      "types": "./dist/sandbox-terminal.d.ts",
      "import": "./dist/sandbox-terminal.js",
      "require": "./dist/sandbox-terminal.cjs"
    }
  },
  "files": [
    "dist",
    "extension",
    "extension-download",
    "desktop-agent",
    "docs",
    "README.md",
    "PUBLISHING.md",
    "LICENSE",
    "desktop-agent-download"
  ],
  "scripts": {
    "build": "tsup && node scripts/prepare-extension.mjs && node scripts/package-extension.mjs && node scripts/package-desktop-agent.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "archiver": "^7.0.1",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
